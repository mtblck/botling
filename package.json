{
  "name": "seedkin",
  "version": "2.4.1",
  "description": "Seedkin: a family of seeded pixel avatars (robots first) drawn as SVG. Zero dependencies.",
  "keywords": [
    "avatar",
    "robot",
    "identicon",
    "svg",
    "generator",
    "pixel-art",
    "seedkin",
    "botling"
  ],
  "license": "MIT",
  "author": "Matt Black (https://mattblack.space)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mtblck/seedkin.git"
  },
  "bugs": "https://github.com/mtblck/seedkin/issues",
  "funding": "https://ko-fi.com/mtblck",
  "homepage": "https://seedkin.dev",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./botling": {
      "types": "./dist/styles/botling/index.d.ts",
      "default": "./dist/styles/botling/index.js"
    },
    "./snoot": {
      "types": "./dist/styles/snoot/index.d.ts",
      "default": "./dist/styles/snoot/index.js"
    },
    "./beastie": {
      "types": "./dist/styles/beastie/index.d.ts",
      "default": "./dist/styles/beastie/index.js"
    },
    "./noggin": {
      "types": "./dist/styles/noggin/index.d.ts",
      "default": "./dist/styles/noggin/index.js"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome format --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "preview": "tsx scripts/preview.ts",
    "hero": "tsx scripts/hero.ts",
    "prepublishOnly": "npm run lint && npm run typecheck && npm test && npm run build",
    "site": "npm run build && node scripts/site.mjs",
    "hosting:check": "node scripts/check-hosting.mjs",
    "serve": "node scripts/serve.mjs",
    "coverage": "vitest run --coverage --coverage.reporter=lcov --coverage.reporter=json-summary --coverage.reporter=text-summary"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.4",
    "@fontsource-variable/pixelify-sans": "^5.3.0",
    "@types/node": "^22.20.5",
    "@vitest/coverage-v8": "^5.0.5",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
